/* get-haiggoh TUI theme — aligned with CSL's CURRENT overall design
   (free-agents/bin/session_picker.py, R5/R9 era): textual-ansi theme with ansi_color
   (no painted background — light/dark/custom terminal themes show through), bold title,
   CYAN subheadline, cyan highlight/hover, grey status line and an italic dim footer pinned
   at the very bottom. The grey tooltip frame around #info is GONE (user 2026-11-09:
   "doesn't need the grey box which looks bad"). */
Screen { layout: vertical; background: ansi_default; color: ansi_default; }
#title { text-style: bold; padding: 0 1; }
#subtitle { color: ansi_bright_cyan; padding: 0 1 1 1; }   /* CSL subheadline = cyan identity line */
#rows { height: 1fr; margin-top: 1; }                        /* blank line before the list */
/* Info box = CSL's tooltip frame (session_picker.py:801): rounded grey border, sitting
   directly on the button row (spacer before it, as CSL composes it). User 2026-11-09 —
   this is CSL's round frame, not the old grey painted box that 0.10.1 removed. */
#info { height: auto; display: none; border: round ansi_bright_black; padding: 0 1; margin: 0 1; color: ansi_default; }
#spacer { height: 0; }                                       /* the list (1fr) takes the flex space */
#buttons { height: auto; padding: 0 1; }
#summary { color: ansi_bright_black; padding: 0 1; }
#hint { color: ansi_black; text-style: italic; padding: 0 1; } /* version-style footer, very bottom */
Button { border: none; padding: 0 1; min-width: 8; }
Button:focus, Button:hover { color: ansi_bright_cyan; text-style: bold; }
OptionList { background: ansi_default; color: ansi_default; border: none; }
OptionList:focus { background: ansi_default; color: ansi_default; border: none; }
OptionList > .option-list--option-highlighted { background: ansi_default; color: ansi_bright_cyan; text-style: bold; }
OptionList > .option-list--option-hover { background: ansi_default; color: ansi_bright_cyan; }
/* rows with no menu are not links: highlight/hover turns them grey, never cyan */
OptionList > .option-list--option-nonlink { background: ansi_default; color: ansi_bright_black; text-style: none; }
/* select mode: rows that can't take part are greyed (disabled), boxes only on the rest */
OptionList > .option-list--option-disabled { background: ansi_default; color: ansi_bright_black; }
Input { background: ansi_default; color: ansi_default; border: round ansi_bright_black; } /* as CSL */
Static { background: ansi_default; color: ansi_default; }
