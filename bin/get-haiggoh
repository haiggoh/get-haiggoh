#!/usr/bin/env python3
"""get-haiggoh -- the command. No arguments on a terminal opens the interactive TUI
(via bin/get-haiggoh-tui, which bootstraps the private venv and falls back to the plain
menu on any failure); anything else is handed to get-haiggoh.py unchanged
(plan, apply, upgrade, shims, --help).

Env: GET_HAIGGOH_MENU_SCRIPT overrides the plain menu (used by tests);
     GET_HAIGGOH_TUI_SCRIPT overrides the TUI bootstrap (used by tests).
See `get-haiggoh --help` for every other variable."""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))


def main(argv):
    if argv:
        script = os.path.join(HERE, "get-haiggoh.py")
        os.execv(sys.executable, [sys.executable, script] + argv)
    if not sys.stdin.isatty():
        print("get-haiggoh: the menu is interactive and needs a terminal. "
              "Try: get-haiggoh plan | apply | upgrade | shims   (or --help)", file=sys.stderr)
        return 2
    menu = os.environ.get("GET_HAIGGOH_MENU_SCRIPT")
    if menu:
        os.execv(sys.executable, [sys.executable, menu])
    tui = os.environ.get("GET_HAIGGOH_TUI_SCRIPT") or os.path.join(HERE, "get-haiggoh-tui")
    os.execv(sys.executable, [sys.executable, tui])


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
