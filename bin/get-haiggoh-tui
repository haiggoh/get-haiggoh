#!/usr/bin/env python3
"""get-haiggoh-tui — bootstrap the private TUI venv and run the get-haiggoh TUI.

Usage: get-haiggoh-tui [--help] [--check] [--resume] [--plain]

  --help     show this help and exit (no side effects — it creates nothing)
  --check    report venv state (path, req-sha match, textual importable); change nothing
  --resume   consume a leftover pending bulk run exactly once
  --plain    exec the plain numbered menu (get-haiggoh-menu) instead of the TUI

Env:
  GET_HAIGGOH_TUI_VENV          venv path (default ~/.local/share/get-haiggoh/tui-venv);
                               a SET-but-invalid path aborts naming the variable
  GET_HAIGGOH_TUI_STATE_FILE    TUI state file (default ~/.claude/.get-haiggoh-tui-state.json)
  GET_HAIGGOH_TUI_PENDING_FILE  pending-run file (default ~/.claude/.get-haiggoh-tui-pending.json)
  GET_HAIGGOH_MENU_SCRIPT       plain-menu override (used by tests)
  GET_HAIGGOH_TUI_FALLBACK_REASON  set here before exec'ing the plain menu on a bootstrap
                               failure (the reason); get-haiggoh-menu prints it under
                               its banner
  GET_HAIGGOH_TOOLS_DIR         where the private uv lives
                               (default ~/.local/share/get-haiggoh/tools)
  GET_HAIGGOH_NO_UV_DOWNLOAD=1  never download the private uv

The venv is rebuilt when sha256(tui-requirements.txt) differs from <venv>/.req-sha,
and recreated when it was built on a Python below 3.10 (the pins need >= 3.10; macOS's
own python3 is 3.9). It is built on the first Python >= 3.10 found — this interpreter,
python3.N on PATH, Homebrew's — else on one uv fetches: a uv on PATH, or a pinned,
checksum-verified uv downloaded into the tools dir. No admin rights, no Homebrew needed.
Any bootstrap failure prints ONE stderr line, passes the reason to the menu via
GET_HAIGGOH_TUI_FALLBACK_REASON (so the menu can show it under its banner), and execs
the plain menu — setup never dead-ends.
"""
import hashlib
import os
import platform
import shutil
import subprocess
import sys
import tarfile
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.dirname(HERE)
REQS = os.path.join(ROOT, "tui-requirements.txt")
DEV_REQS = os.path.join(ROOT, "tui-dev-requirements.txt")
DEFAULT_VENV = os.path.join(os.path.expanduser("~/.local/share"), "get-haiggoh", "tui-venv")
STAMP = ".req-sha"


def req_sha():
    with open(REQS, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def venv_path():
    v = os.environ.get("GET_HAIGGOH_TUI_VENV")
    if v:
        # a SET override that exists but is not a directory is invalid and aborts
        # naming the variable; a not-yet-existing path is a build target and is fine
        if os.path.exists(v) and not os.path.isdir(v):
            sys.stderr.write(f"get-haiggoh-tui: GET_HAIGGOH_TUI_VENV={v!r} is not a directory\n")
            raise SystemExit(2)
        return v
    return DEFAULT_VENV


def venv_python(venv):
    return os.path.join(venv, "bin", "python")


# The pins (markdown-it-py 4, platformdirs 4.12, truststore, ...) need Python >= 3.10.
# macOS ships /usr/bin/python3 = 3.9, which is the FIRST python3 on a fresh Mac's PATH:
# a venv built from it can never install them, so every launch fell back to the plain menu.
MIN_PY = (3, 10)
NEED_PY = ("the TUI needs Python >= 3.10 and none was found (macOS's own python3 is 3.9); "
           "get-haiggoh normally fetches a private uv + Python itself (no admin, no Homebrew), "
           "but that was skipped (GET_HAIGGOH_NO_UV_DOWNLOAD is set) or failed — fix the "
           "network or install any Python >= 3.10, then run get-haiggoh again")

# The admin-free, Homebrew-free route: a PINNED uv release, checked against a HARDCODED
# sha256 (verified 2026-11-25 against the release's .sha256 files AND the GitHub API asset
# digests), unpacked into the user's home. uv then fetches a standalone CPython, also into
# the home directory. Bump all three together.
UV_VERSION = "0.13.9"
UV_SHA256 = {
    "uv-aarch64-apple-darwin.tar.gz":
        "5aeca67f2283f75235de40d0bd9c0a5bbc5fce23b6d48b3bf9fa1b2db08382ca",
    "uv-x86_64-apple-darwin.tar.gz":
        "617a3211261b0fc739562f0071aa34e9739797c510208ede8e2977c30903d041",
}
DEFAULT_TOOLS = os.path.join(os.path.expanduser("~/.local/share"), "get-haiggoh", "tools")


def tools_dir():
    d = os.environ.get("GET_HAIGGOH_TOOLS_DIR")
    if d and os.path.exists(d) and not os.path.isdir(d):
        raise RuntimeError(f"GET_HAIGGOH_TOOLS_DIR={d!r} is not a directory")
    return d or DEFAULT_TOOLS


def uv_asset():
    """The release asset for this machine, or None where no pin exists (non-macOS)."""
    if sys.platform != "darwin":
        return None
    arch = {"arm64": "aarch64", "x86_64": "x86_64"}.get(platform.machine())
    return f"uv-{arch}-apple-darwin.tar.gz" if arch else None


def uv_env():
    """Corporate networks re-sign TLS with a CA that lives only in the system keychain:
    make uv trust it (new flag name and the older one; unknown names are ignored)."""
    env = os.environ.copy()
    env.update(UV_SYSTEM_CERTS="1", UV_NATIVE_TLS="1")
    return env


def fetch_uv(dest_dir, url, sha256):
    """Download with the system curl (it trusts the keychain, so it works behind a TLS-
    inspecting proxy where Python 3.9's urllib does not), verify sha256, extract ONLY the
    `uv` member by name (never extractall), install atomically as <dest_dir>/uv.
    Returns the path; RuntimeError on any failure, leaving no `uv` behind."""
    os.makedirs(dest_dir, exist_ok=True)
    curl = shutil.which("curl") or "/usr/bin/curl"
    fd, tar_path = tempfile.mkstemp(dir=dest_dir, suffix=".tar.gz")
    os.close(fd)
    bin_tmp = None
    try:
        # bounded so a stalled/black-holed connection fails fast into the plain-menu
        # fallback instead of hanging the bootstrap (review 2026-11-25)
        _run([curl, "-fsSL", "--retry", "2", "--connect-timeout", "10",
              "--max-time", "300", "-o", tar_path, url])
        with open(tar_path, "rb") as f:
            got = hashlib.sha256(f.read()).hexdigest()
        if got != sha256:
            raise RuntimeError(f"uv download sha256 mismatch for {url} "
                               f"(expected {sha256[:12]}…, got {got[:12]}…)")
        with tarfile.open(tar_path, "r:gz") as t:
            member = next((m for m in t.getmembers()
                           if m.isfile() and os.path.basename(m.name) == "uv"), None)
            src = t.extractfile(member) if member is not None else None
            if src is None:
                raise RuntimeError(f"no uv binary inside {url}")
            data = src.read()
        fd, bin_tmp = tempfile.mkstemp(dir=dest_dir)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        os.chmod(bin_tmp, 0o755)
        final = os.path.join(dest_dir, "uv")
        os.replace(bin_tmp, final)
        bin_tmp = None
        return final
    finally:
        for p in (tar_path, bin_tmp):
            if p and os.path.exists(p):
                os.remove(p)


def _private_uv_path():
    return os.path.join(tools_dir(), f"uv-{UV_VERSION}", "uv")


def cached_private_uv():
    p = _private_uv_path()
    return p if os.access(p, os.X_OK) else None


def private_uv():
    """The pinned private uv, downloading it on first use; None when downloads are
    disabled (GET_HAIGGOH_NO_UV_DOWNLOAD) or no pin exists for this machine."""
    if os.environ.get("GET_HAIGGOH_NO_UV_DOWNLOAD"):
        return None
    cached = cached_private_uv()
    if cached:
        return cached
    asset = uv_asset()
    if not asset:
        return None
    url = f"https://github.com/astral-sh/uv/releases/download/{UV_VERSION}/{asset}"
    return fetch_uv(os.path.dirname(_private_uv_path()), url, UV_SHA256[asset])


def py_version(exe):
    """(major, minor) of an interpreter, or None when it cannot be run."""
    try:
        r = subprocess.run([exe, "-c", "import sys; print(*sys.version_info[:2])"],
                           capture_output=True, text=True, timeout=15)
        if r.returncode != 0:
            return None  # prints a version but exits nonzero (broken shim/wrapper): unusable
        major, minor = r.stdout.split()[:2]
        return (int(major), int(minor))
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def base_python_candidates():
    """Our own interpreter first, then the newest python3.N on PATH, then Homebrew's."""
    found = [sys.executable]
    for minor in range(20, MIN_PY[1] - 1, -1):
        exe = shutil.which(f"python3.{minor}")
        if exe:
            found.append(exe)
    found += ["/opt/homebrew/bin/python3", "/usr/local/bin/python3", shutil.which("python3")]
    return list(dict.fromkeys(p for p in found if p))


def find_base_python(candidates=None):
    """First candidate at or above MIN_PY, or None."""
    for exe in (base_python_candidates() if candidates is None else candidates):
        v = py_version(exe)
        if v is not None and v >= MIN_PY:
            return exe
    return None


def venv_py_version(venv):
    """(major, minor) the venv was built with, read from pyvenv.cfg (no subprocess);
    None when there is no readable version."""
    try:
        with open(os.path.join(venv, "pyvenv.cfg"), encoding="utf-8") as f:
            for line in f:
                key, _, value = line.partition("=")
                if key.strip() in ("version_info", "version"):
                    major, minor = value.strip().split(".")[:2]
                    return (int(major), int(minor))
    except (OSError, ValueError):
        pass
    return None


def venv_ok(venv):
    """True when the venv has a python at or above MIN_PY and its req stamp matches
    tui-requirements.txt."""
    if not os.path.isfile(venv_python(venv)):
        return False
    v = venv_py_version(venv)
    if v is None or v < MIN_PY:
        return False
    try:
        with open(os.path.join(venv, STAMP), encoding="utf-8") as f:
            return f.read().strip() == req_sha()
    except OSError:
        return False


def _run(cmd, env=None):
    r = subprocess.run(cmd, capture_output=True, text=True, env=env)
    if r.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd[:3])}… exited {r.returncode}: "
                           f"{(r.stderr or r.stdout).strip()[:200]}")


def create_venv(venv):
    """(Re)build the venv on an interpreter >= MIN_PY, clearing whatever is there.
    Route order — nothing here needs admin rights or Homebrew:
      1. a local Python >= MIN_PY (Homebrew's counts when present), via uv on PATH or stdlib venv
      2. uv on PATH asked for >= MIN_PY (it downloads a managed Python when none is local)
      3. the pinned private uv (downloaded into the home dir), likewise
    Returns the uv used (later pip installs must use it: uv venvs carry no pip), or None.
    Refuses to clear a non-empty directory that is not a venv (an override path)."""
    if os.path.isdir(venv) and os.listdir(venv) and \
            not os.path.isfile(os.path.join(venv, "pyvenv.cfg")):
        raise RuntimeError(f"{venv} is not empty and not a venv — refusing to clear it")
    floor = ">={}.{}".format(*MIN_PY)
    base = find_base_python()
    uv = shutil.which("uv")
    if uv:
        try:
            _run([uv, "venv", "--clear", "--python", base or floor, venv], env=uv_env())
            return uv
        except RuntimeError:
            pass  # a broken uv on PATH must not block route 3, the pinned private uv
                  # (review 2026-11-25: it exists precisely for machines without a local
                  # Python >= MIN_PY)
    if base:
        _run([base, "-m", "venv", "--clear", venv])
        return None
    try:
        uv = private_uv()
    except RuntimeError as exc:
        raise RuntimeError(f"{NEED_PY} ({exc})") from exc
    if not uv:
        raise RuntimeError(NEED_PY)
    _run([uv, "venv", "--clear", "--python", floor, venv], env=uv_env())
    return uv


def ensure_venv(venv):
    """Create/refresh the private venv and install the pins; rewrite .req-sha.
    A missing venv, or one built on a Python below MIN_PY, is rebuilt first.
    Raises RuntimeError on failure."""
    if venv_ok(venv):
        return
    v = venv_py_version(venv)
    uv = None
    if not os.path.isfile(venv_python(venv)) or v is None or v < MIN_PY:
        uv = create_venv(venv)
    py = venv_python(venv)
    if os.path.isfile(os.path.join(venv, "bin", "pip")):
        uv = None  # a stdlib-built venv has a working pip of its own — don't re-select a uv
                   # that just failed `venv` (review 2026-11-25)
    else:
        uv = uv or shutil.which("uv") or cached_private_uv()
        if not uv:
            uv = private_uv()  # a uv-built venv has no pip of its own
    if uv:
        _run([uv, "pip", "install", "--python", py, "-r", REQS, "-r", DEV_REQS], env=uv_env())
    else:
        _run([py, "-m", "pip", "install", "-r", REQS, "-r", DEV_REQS])
    with open(os.path.join(venv, STAMP), "w", encoding="utf-8") as f:
        f.write(req_sha() + "\n")


# The FIRST thing on screen is the loading frame (PORTED from free-agents bin/session-picker,
# CHANGELOG 0.22.1): the alternate screen hides whatever the shell printed, then
# "⏳ loading ..." with the cursor hidden. Textual takes over the same alternate screen
# without a flash. Only on a terminal — pipes, logs and --help/--check get no escape bytes.
FRAME_ON = "\033[?1049h\033[2J\033[H\033[?25l  ⏳ loading ...  "
FRAME_OFF = "\033[?25h\033[?1049l"
_frame_shown = False


def show_frame():
    global _frame_shown
    if sys.stdout.isatty():
        sys.stdout.write(FRAME_ON)
        sys.stdout.flush()
        _frame_shown = True


def hide_frame():
    """Give the normal screen back before anything that is not Textual (plain menu, errors)."""
    global _frame_shown
    if _frame_shown:
        sys.stdout.write(FRAME_OFF)
        sys.stdout.flush()
        _frame_shown = False


def plain_menu(reason=None):
    """Exec the plain menu. A bootstrap `reason` is exported as
    GET_HAIGGOH_TUI_FALLBACK_REASON so the menu can show why the TUI is unavailable;
    a bare --plain clears any stale value instead."""
    hide_frame()
    if reason is None:
        os.environ.pop("GET_HAIGGOH_TUI_FALLBACK_REASON", None)
    else:
        os.environ["GET_HAIGGOH_TUI_FALLBACK_REASON"] = reason
    menu = os.environ.get("GET_HAIGGOH_MENU_SCRIPT") or os.path.join(HERE, "get-haiggoh-menu")
    os.execv(sys.executable, [sys.executable, menu])


def check(venv):
    ok = venv_ok(venv)
    textual = ""
    if ok:
        r = subprocess.run([venv_python(venv), "-c", "import textual; print(textual.__version__)"],
                           capture_output=True, text=True)
        textual = r.stdout.strip() if r.returncode == 0 else f"IMPORT FAILED: {r.stderr.strip()[:120]}"
    print(f"venv: {venv}")
    print(f"req-sha matches tui-requirements.txt: {'yes' if ok else 'no'}")
    print(f"textual: {textual or '(not checked — venv not ok)'}")
    print("status: " + ("ok" if ok and textual and not textual.startswith("IMPORT") else "not ok"))
    return 0 if (ok and textual and not textual.startswith("IMPORT")) else 1


def main(argv):
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    unknown = [a for a in argv if a not in ("--check", "--resume", "--plain")]
    if unknown:
        sys.stderr.write(f"usage: get-haiggoh-tui [--help] [--check] [--resume] [--plain] "
                         f"(unrecognized: {' '.join(unknown)})\n")
        return 2
    if "--plain" in argv:
        plain_menu()
        return 0  # unreachable when exec works
    venv = venv_path()  # exits 2 naming a set-but-invalid GET_HAIGGOH_TUI_VENV
    if "--check" in argv:
        return check(venv)
    show_frame()  # before the venv check: a rebuild can take a while
    try:
        ensure_venv(venv)
    except Exception as exc:
        hide_frame()
        sys.stderr.write(f"get-haiggoh: TUI unavailable ({exc}) — opening the plain menu\n")
        plain_menu(reason=str(exc))
        return 0
    env = os.environ.copy()
    env["PYTHONPATH"] = ROOT + (os.pathsep + env["PYTHONPATH"] if env.get("PYTHONPATH") else "")
    extra = ["--resume"] if "--resume" in argv else []
    os.execve(venv_python(venv),
              [venv_python(venv), "-m", "get_haiggoh_tui", *extra], env)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
